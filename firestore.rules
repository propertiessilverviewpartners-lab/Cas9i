rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core reusable primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'info.mipodi@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Entity validators
    function isValidAdminMember(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'id', 'username', 'fullName', 'email', 'avatar',
          'balance', 'verified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authUid', 'username', 'fullName', 'email', 'avatar',
          'balance', 'verified', 'createdAt', 'updatedAt',
          'phone', 'country', 'city', 'address', 'dateOfBirth',
          'kycIdNumber', 'accountTier', 'notes',
          'lastDepositAt', 'lastDepositAmount',
          'totalBetsPlaced', 'totalWon',
          'placedBetsCount', 'fxPositionsCount'
        ])
        && isValidId(data.id)
        && (!('authUid' in data) || (data.authUid is string && data.authUid.size() <= 128))
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 64
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 16
        && data.balance is number && data.balance >= 0
        && data.verified is bool
        && data.createdAt is number && data.createdAt > 0
        && data.updatedAt is timestamp
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80))
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && (!('dateOfBirth' in data) || (data.dateOfBirth is string && data.dateOfBirth.size() <= 32))
        && (!('kycIdNumber' in data) || (data.kycIdNumber is string && data.kycIdNumber.size() <= 64))
        && (!('accountTier' in data) || (data.accountTier in ['Standard', 'VIP', 'Suspended']))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('lastDepositAt' in data) || data.lastDepositAt is number)
        && (!('lastDepositAmount' in data) || (data.lastDepositAmount is number && data.lastDepositAmount >= 0))
        && (!('totalBetsPlaced' in data) || (data.totalBetsPlaced is number && data.totalBetsPlaced >= 0))
        && (!('totalWon' in data) || (data.totalWon is number && data.totalWon >= 0))
        && (!('placedBetsCount' in data) || (data.placedBetsCount is number && data.placedBetsCount >= 0))
        && (!('fxPositionsCount' in data) || (data.fxPositionsCount is number && data.fxPositionsCount >= 0));
    }

    function isValidDeletedUser(data) {
      return data.keys().hasAll(['userId', 'deletedAt', 'deletedBy'])
        && data.keys().hasOnly(['userId', 'deletedAt', 'deletedBy'])
        && isValidId(data.userId)
        && data.deletedAt is timestamp
        && data.deletedBy is string && data.deletedBy.size() >= 1 && data.deletedBy.size() <= 128;
    }

    function isValidCounterDoc(data) {
      return data.keys().hasAll(['nextUserNumericId', 'updatedAt'])
        && data.keys().hasOnly(['nextUserNumericId', 'updatedAt'])
        && data.nextUserNumericId is int && data.nextUserNumericId >= 100001
        && data.updatedAt is timestamp;
    }

    function isValidClubEntity(data) {
      return data.keys().hasAll(['id', 'name', 'shortName', 'country', 'league', 'crest', 'attack', 'defense', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'shortName', 'country', 'league', 'crest', 'attack', 'defense', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.shortName is string && data.shortName.size() >= 1 && data.shortName.size() <= 10
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 80
        && data.league is string && data.league.size() >= 1 && data.league.size() <= 120
        && data.crest is string && data.crest.size() >= 1 && data.crest.size() <= 16
        && data.attack is number && data.attack >= 1 && data.attack <= 100
        && data.defense is number && data.defense >= 1 && data.defense <= 100
        && data.updatedAt is timestamp;
    }

    function isValidDeletedClub(data) {
      return data.keys().hasAll(['clubId', 'deletedAt', 'deletedBy'])
        && data.keys().hasOnly(['clubId', 'deletedAt', 'deletedBy'])
        && isValidId(data.clubId)
        && data.deletedAt is timestamp
        && data.deletedBy is string && data.deletedBy.size() >= 1 && data.deletedBy.size() <= 128;
    }

    function isValidLeagueEntity(data) {
      return data.keys().hasAll(['id', 'name', 'country', 'icon', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'country', 'icon', 'isCustom', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 80
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 16
        && (!('isCustom' in data) || data.isCustom is bool)
        && data.createdAt is number && data.createdAt > 0
        && data.updatedAt is timestamp;
    }

    function isValidMatchEntity(data) {
      return data.keys().hasAll([
          'id', 'league', 'country', 'homeTeam', 'awayTeam',
          'homeScore', 'awayScore', 'minute', 'status', 'startsInSeconds',
          'homeOdds', 'drawOdds', 'awayOdds', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'league', 'country', 'homeTeam', 'awayTeam',
          'homeClubId', 'awayClubId',
          'homeScore', 'awayScore', 'minute', 'status', 'startsInSeconds',
          'isFeatured', 'homeOdds', 'drawOdds', 'awayOdds', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.league is string && data.league.size() >= 1 && data.league.size() <= 120
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 80
        && data.homeTeam is string && data.homeTeam.size() >= 1 && data.homeTeam.size() <= 100
        && data.awayTeam is string && data.awayTeam.size() >= 1 && data.awayTeam.size() <= 100
        && (!('homeClubId' in data) || (data.homeClubId is string && data.homeClubId.size() <= 128))
        && (!('awayClubId' in data) || (data.awayClubId is string && data.awayClubId.size() <= 128))
        && data.homeScore is number && data.homeScore >= 0
        && data.awayScore is number && data.awayScore >= 0
        && data.minute is number && data.minute >= 0
        && data.status in ['UPCOMING', 'LIVE', 'FINISHED']
        && data.startsInSeconds is number && data.startsInSeconds >= 0
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && data.homeOdds is number && data.homeOdds >= 1.0
        && data.drawOdds is number && data.drawOdds >= 1.0
        && data.awayOdds is number && data.awayOdds >= 1.0
        && data.updatedAt is timestamp;
    }

    // Admins registry
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow create, update: if isBootstrappedAdmin() && isValidId(adminUid) && isValidAdminMember(incoming()) && incoming().uid == adminUid && incoming().createdAt == request.time;
      allow delete: if isBootstrappedAdmin() && isValidId(adminUid);
    }

    // Registered users (permanent until Admin deletes)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isAdmin() || existing().authUid == request.auth.uid);
      allow list: if isBootstrappedAdmin() || (isSignedIn() && existing().authUid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == userId
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().authUid == request.auth.uid
            && incoming().balance == 0
            && incoming().verified == true
            && (!('accountTier' in incoming()) || incoming().accountTier == 'Standard')
          )
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().authUid == request.auth.uid
            && incoming().authUid == existing().authUid
            && incoming().verified == existing().verified
            && (!('accountTier' in incoming()) || incoming().accountTier == existing().accountTier)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'fullName', 'avatar', 'phone', 'country', 'city',
              'address', 'dateOfBirth', 'balance', 'totalBetsPlaced', 'totalWon',
              'placedBetsCount', 'fxPositionsCount', 'updatedAt'
            ])
          )
          || (
            existing().email == request.auth.token.email
            && (!('authUid' in existing()) || existing().authUid == '')
            && incoming().authUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // Tombstones for deleted users
    match /deletedUsers/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isBootstrappedAdmin();
      allow create, update: if isAdmin()
        && isValidId(userId)
        && isValidDeletedUser(incoming())
        && incoming().userId == userId
        && incoming().deletedAt == request.time;
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Sequential numeric ID counter
    match /meta/{counterId} {
      allow get: if isSignedIn() && isValidId(counterId);
      allow create: if isSignedIn()
        && counterId == 'counters'
        && isValidCounterDoc(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && counterId == 'counters'
        && isValidCounterDoc(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().nextUserNumericId == existing().nextUserNumericId + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['nextUserNumericId', 'updatedAt'])
          )
        );
    }

    // Virtual clubs
    match /clubs/{clubId} {
      allow get: if isSignedIn() && isValidId(clubId);
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(clubId)
        && isValidClubEntity(incoming())
        && incoming().id == clubId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(clubId)
        && isValidClubEntity(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(clubId);
    }

    // Tombstones for deleted clubs
    match /deletedClubs/{clubId} {
      allow get: if isSignedIn() && isValidId(clubId);
      allow list: if isBootstrappedAdmin();
      allow create, update: if isAdmin()
        && isValidId(clubId)
        && isValidDeletedClub(incoming())
        && incoming().clubId == clubId
        && incoming().deletedAt == request.time;
      allow delete: if isAdmin() && isValidId(clubId);
    }

    // Virtual leagues
    match /leagues/{leagueId} {
      allow get: if isSignedIn() && isValidId(leagueId);
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(leagueId)
        && isValidLeagueEntity(incoming())
        && incoming().id == leagueId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(leagueId)
        && isValidLeagueEntity(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(leagueId);
    }

    // Admin-fixed virtual matches
    match /matches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId);
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(matchId)
        && isValidMatchEntity(incoming())
        && incoming().id == matchId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(matchId)
        && isValidMatchEntity(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(matchId);
    }
  }
}
